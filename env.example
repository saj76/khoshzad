# ~/.config/weekly-bot/.env  (chmod 600) — personal bot, never the team's Notify-Me bot token.
# systemd does NOT strip inline comments: keep every comment on its own line, values bare.

DISCORD_BOT_TOKEN=

# your numeric Discord user id — run /whoami in Discord once the bot is online
OWNER_ID=

# the private channel for reports + questions; empty = DMs / any channel you're in
CHANNEL_ID=

REPORTS_DIR=/home/sajjad/weekly-reports
VAULT_DIR=/home/sajjad/obsidian-vault
SKILL_SCRIPT=/home/sajjad/.claude/skills/weekly-report/scripts/weekly_report.py

# root that holds the code repos (for commits() / MR lookups) — same default as /weekly-report
ROOT_DIR=/home/sajjad/Notify-Me
GIT_AUTHOR=Sajjad Vahedi

TZ_NAME=Asia/Tehran

# weekly report + brag document + snippet: Thursday (Monday=0) at 19:00
POST_DOW=3
POST_HOUR=19

# evening close: every Sun–Thu at 17:30 (writes the vault; needs write deploy-key access — see README)
EVENING_HOUR=17
EVENING_MINUTE=30

QA_TIMEOUT=240
WEEKLY_TIMEOUT=2400
